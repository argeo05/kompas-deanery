{
  "name": "kompas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security --passWithNoTests",
    "verify": "pnpm typecheck && pnpm lint && vitest run --project unit --project integration --project security --passWithNoTests",
    "test:e2e": "playwright test --grep-invert @shots",
    "test:a11y": "playwright test tests/a11y",
    "shots": "playwright test --grep @shots",
    "db:up": "docker compose up -d --wait db && tsx db/ensure-databases.ts",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "tsx db/reset.ts && tsx db/migrate.ts",
    "db:seed": "tsx db/seed/index.ts",
    "eval:assistant": "tsx scripts/eval-assistant.ts",
    "reseed:nightly": "tsx scripts/nightly-reseed.ts",
    "db:seed-kb": "tsx db/seed/kb-cli.ts",
    "verify:ds": "pnpm typecheck && pnpm lint && vitest run --project unit --project integration",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "ics": "3.12.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "rate-limiter-flexible": "11.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "9.5.13",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "ical.js": "2.2.1",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
