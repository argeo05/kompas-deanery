{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3100 HOSTNAME=127.0.0.1 TRUSTED_PROXY=true node scripts/start-standalone.mjs",
      "startServerReadyPattern": "Ready|started server|Local",
      "url": [
        "http://127.0.0.1:3100/login",
        "http://127.0.0.1:3100/jury",
        "http://127.0.0.1:3100/about",
        "http://127.0.0.1:3100/security",
        "http://127.0.0.1:3100/offline"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "docs/process/lighthouse" }
  }
}
