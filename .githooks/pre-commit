#!/bin/sh
# gitleaks по staged-изменениям (SPEC C-24). Подключается автоматически: pnpm install → prepare.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks не установлен (brew install gitleaks). Коммит остановлен." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
