# Обратный прокси Компаса (SPEC §8, §9.7, D-005, D-017). HTTPS — автоматически (Let's Encrypt).
# {$KOMPAS_DOMAIN} — домен из .env.prod; без домена — ":80" (только для проверки на сервере).
{$KOMPAS_DOMAIN::80} {
	encode zstd gzip

	# Пишем в журнал без IP и без query: персональных данных в логах быть не должно (SPEC §8.5).
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format filter {
			wrap json
			request>remote_ip delete
			request>client_ip delete
			request>headers delete
			request>uri query {
				delete *
			}
		}
	}

	reverse_proxy app:3000 {
		# Единственный источник IP для лимитов (client-ip.ts): перезаписываем то, что прислал клиент.
		header_up X-Real-IP {remote_host}
		# Подделку цепочки не пропускаем: приложение X-Forwarded-For не читает, но и дальше не передаём.
		header_up -X-Forwarded-For
		health_uri /api/health
		health_interval 15s
	}
	# CSP с nonce и HSTS выставляет само приложение (proxy.ts, security-headers.ts): здесь не дублируем.
}
