# Скопируйте в .env и заполните. Файл .env не коммитится.
# Базы (D-004): kompas_dev — разработка, kompas_test — тесты; kompas_ds_* — worktree DeepSeek (scripts/ds-worktree.sh).
POSTGRES_DB=kompas_dev
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
# Рабочая база приложения: postgres://<user>:<password>@localhost:<port>/kompas_dev
DATABASE_URL=
# База тестов integration и security: postgres://<user>:<password>@localhost:<port>/kompas_test
# Тесты не стартуют без неё и отказываются работать, если она совпадает с DATABASE_URL.
TEST_DATABASE_URL=

# Better Auth (SPEC §6.1, §9.2): секрет — openssl rand -hex 32; адрес — публичный origin приложения
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Заголовок с IP клиента, который ставит наш прокси (не клиентский X-Forwarded-For)
AUTH_IP_HEADER=x-real-ip
